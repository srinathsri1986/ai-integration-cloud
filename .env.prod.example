# Copy this to .env.prod and fill in real values.
# NEVER commit .env.prod to git.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password_here

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
PLACEHOLDER_JWT_SECRET=change_me_64_char_hex_secret
JWT_SECRET_KEY=change_me_64_char_hex_secret_2

# ── Connector encryption (Fernet) ─────────────────────────────────────────────
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=

# ── App URLs ──────────────────────────────────────────────────────────────────
# Set to your EC2 public IP or domain
NEXT_PUBLIC_API_BASE_URL=http://3.26.40.205
API_CORS_ORIGINS=http://3.26.40.205

# ── Docker images ─────────────────────────────────────────────────────────────
# After building: docker build -t aic-api:latest -f apps/api/Dockerfile .
API_IMAGE=aic-api:latest
WEB_IMAGE=aic-web:latest

# ── AI provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=mock
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── NetSuite ──────────────────────────────────────────────────────────────────
NETSUITE_MODE=mock
