# Local development placeholders only. Do not put real credentials in source control.

ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_DB=cfo_orchestrator
POSTGRES_USER=cfo_app
POSTGRES_PASSWORD=local_dev_password
DATABASE_URL=postgresql+psycopg://cfo_app:local_dev_password@postgres:5432/cfo_orchestrator

REDIS_URL=redis://redis:6379/0

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
PLACEHOLDER_JWT_SECRET=replace-with-local-dev-secret

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

MCP_SERVER_NAME=netsuite-cfo-intelligence
MCP_API_BASE_URL=http://api:8000

# NetSuite integration is intentionally mocked for the MVP scaffold.
NETSUITE_MODE=mock
NETSUITE_ACCOUNT_ID=placeholder-account
NETSUITE_CLIENT_ID=placeholder-client-id
NETSUITE_CLIENT_SECRET=placeholder-client-secret
NETSUITE_TOKEN_ID=placeholder-token-id
NETSUITE_TOKEN_SECRET=placeholder-token-secret

# AI provider defaults to mock. Local build/test does not require a real key.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
